    Label.Position = UDim2.new(0, 10, 0, 0)
    Label.Size = UDim2.new(1, -100, 1, 0)
    Label.Font = Enum.Font.GothamSemibold
    Label.Text = text
    Label.TextColor3 = TextColor
    Label.TextSize = 12
    Label.TextXAlignment = Enum.TextXAlignment.Left

    local SelectBtn = Instance.new("TextButton")
    SelectBtn.Parent = DropFrame
    SelectBtn.BackgroundColor3 = SidebarColor
    SelectBtn.Position = UDim2.new(1, -90, 0.5, -10)
    SelectBtn.Size = UDim2.new(0, 80, 0, 20)
    SelectBtn.Text = options[1]
    SelectBtn.TextColor3 = TextColor
    SelectBtn.Font = Enum.Font.Gotham
    SelectBtn.TextSize = 11
    local SelectCorner = Instance.new("UICorner")
    SelectCorner.CornerRadius = UDim.new(0, 4)
    SelectCorner.Parent = SelectBtn

    -- (Đơn giản hóa: Chỉ đổi giá trị khi bấm, chưa làm menu xổ xuống phức tạp)
    local currentIndex = 1
    SelectBtn.MouseButton1Click:Connect(function()
        currentIndex = currentIndex + 1
        if currentIndex > #options then currentIndex = 1 end
        SelectBtn.Text = options[currentIndex]
        if callback then callback(options[currentIndex]) end
    end)
end

