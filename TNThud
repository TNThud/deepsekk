    BtnCorner.CornerRadius = UDim.new(0, 5)
    BtnCorner.Parent = Btn
    MenuButtons[name] = Btn
end

local function SwitchTab(tabName)
    for pName, page in pairs(Pages) do page.Visible = (pName == tabName) end
    for bName, btn in pairs(MenuButtons) do
        btn.BackgroundColor3 = (bName == tabName) and AccentColor or SidebarColor
        btn.TextColor3 = (bName == tabName) and TextColor or TextGray
    end
end

local tabNames = {"Main", "Boss", "Raid", "Fruit", "Sea Events", "ESP", "Teleport", "Combat", "Misc", "Race"}
