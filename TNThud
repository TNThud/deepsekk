-- Hàm tạo Trang (Page)
local Pages = {}
local function CreatePage(name)
    local Page = Instance.new("Frame")
    Page.Name = name
    Page.Parent = ContentArea
    Page.BackgroundTransparency = 1
    Page.Size = UDim2.new(1, 0, 1, 0)
    Page.Visible = false
    Pages[name] = Page
    return Page
end

-- Hàm tạo Nút Menu
local MenuButtons = {}
local function CreateMenuBtn(name, layoutOrder)
    local Btn = Instance.new("TextButton")
    Btn.Parent = Sidebar
    Btn.Size = UDim2.new(1, 0, 0, 30)
    Btn.BackgroundColor3 = SidebarColor
    Btn.BorderSizePixel = 0
    Btn.Text = "  " .. name
    Btn.TextColor3 = TextGray
    Btn.Font = Enum.Font.GothamSemibold
    Btn.TextSize = 12
    Btn.TextXAlignment = Enum.TextXAlignment.Left
    Btn.LayoutOrder = layoutOrder
    
    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 5)
    BtnCorner.Parent = Btn
    
    MenuButtons[name] = Btn
    return Btn
end

-- Hàm đổi Tab
local function SwitchTab(tabName)
    for pName, page in pairs(Pages) do
        page.Visible = (pName == tabName)
    end
    for bName, btn in pairs(MenuButtons) do
        if bName == tabName then
            btn.BackgroundColor3 = AccentColor
            btn.TextColor3 = TextColor
        else
            btn.BackgroundColor3 = SidebarColor
            btn.TextColor3 = TextGray
        end
    end
end

-- Tạo các Tab
local tabNames = {"Home", "Scripts", "Utilities", "Visuals", "Teleports", "Settings"}

for i, name in ipairs(tabNames) do
    local btn = CreateMenuBtn(name, i)
    local page = CreatePage(name)
    
    -- Gắn sự kiện click để chuyển tab
    btn.MouseButton1Click:Connect(function()
        SwitchTab(name)
    end)
end

